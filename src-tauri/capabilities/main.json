{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Everything Lexicon's window may do: read and write its own two data files, save files the person chooses, toggle full screen, and open Merriam-Webster pages in the system browser. No filesystem, shell or network access.",
  "windows": ["main"],
  "permissions": [
    "allow-load-words",
    "allow-save-words",
    "allow-load-profile",
    "allow-save-profile",
    "allow-snapshot-data",
    "allow-show-data-folder",
    "allow-save-file",
    "allow-toggle-fullscreen",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.merriam-webster.com/dictionary/*" },
        { "url": "https://merriam-webster.com/dictionary/*" }
      ]
    }
  ]
}
